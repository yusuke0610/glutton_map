# バックエンド(docker-compose)の環境変数の雛形。
# `cp .env.example .env` してから値を埋め、`make up` で docker compose に読み込ませる。
# ここに無い変数は main.go からは見えない（compose 経由でコンテナに渡していないため）。

# DB の接続先。未設定なら file:./data/pins.db（コンテナ内は /app/data/pins.db、
# docker-compose.yml のボリュームマウントで永続化される）。
LIBSQL_URL=file:./data/pins.db

# 許可するフロントのオリジン（カンマ区切りで複数可）。未設定なら http://localhost:5174。
CORS_ALLOW_ORIGINS=http://localhost:5174

# 必須。ip_hash（投稿者の匿名識別子）生成の salt。未設定だとサーバが起動しない。
# 一度決めたら変更しないこと（変えると過去の ip_hash と一致しなくなり、
# ファン数集計で同一人物が別人として数えられる）。長くランダムな文字列を使う。
IP_HASH_SALT=change-me-to-a-random-secret

# リバースプロキシ/ロードバランサの背後に置く場合、ClientIP() の信頼境界として
# そのIP（カンマ区切り）を指定する。GIN_MODE=release のとき未設定だと起動失敗する。
# 未設定時の既定は localhost のみ信頼（直公開向け）。
TRUSTED_PROXIES=

# X共有(OGP)の og:image/og:url を絶対URL化するための公開ベースURL（https 推奨）。
# 未設定なら http://localhost:8001（ローカル開発用）。
PUBLIC_BASE_URL=http://localhost:8001

# 共有リンクを踏んだ人間の着地先（フロントのオリジン）。未設定なら http://localhost:5174。
FRONTEND_BASE_URL=http://localhost:5174

# リッスンポート。未設定なら 8001。
PORT=8001

# true のとき DB が空なら初期ピンを投入する。実運用では既定（未設定=無効）のままにする。
SEED_ON_START=

# release にすると本番向けの挙動になり、TRUSTED_PROXIES 未設定時の起動失敗チェックも
# 有効になる。未設定なら debug（ローカル開発向け）。
GIN_MODE=
